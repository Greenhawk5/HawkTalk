{
  "name": "hawktalk-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0 <23" },
  "scripts": {
    "dev": "wrangler dev --env dev --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "types": "wrangler types --env dev",
    "typecheck": "npm run types && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "wrangler deploy --env dev --dry-run --outdir dist",
    "provision": "node --experimental-strip-types scripts/provision.mjs",
    "security": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run security"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
